# Postgres в Docker (порт 5433, чтобы не конфликтовать с локальным Postgres на 5432)
POSTGRES_DB=puzzle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# Роль только на чтение — под ней исполняются все запросы, построенные из запроса пользователя
BI_READER_PASSWORD=bi_reader

# Роль приложения — владеет схемой app (сохранённые дашборды)
APP_PASSWORD=app

# NL-слой
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
